// Tests for `Ast::collect_links` — the source-DFS link enumeration.
// Covers every scenario in
// specs/markdown-link-enumeration/spec.md.
module LinkEnumerationTest;

import Yaynu.Markdown.Ast;
import Yaynu.Markdown.Parser;

run_empty_document : IO ();
run_empty_document = (
    let doc = Document { blocks : [] };
    let links = collect_links(doc);
    assert_eq(|_| "empty document → empty link array", links.get_size, 0)
);

run_multiple_links_across_paragraphs : IO ();
run_multiple_links_across_paragraphs = (
    let src = "[A](http://a)\n\n[B](http://b)\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    assert_eq(|_| "two paragraphs yield two links", links.get_size, 2);;
    assert_eq(|_| "first link URL", links.@(0).@url, "http://a");;
    assert_eq(|_| "first link index", links.@(0).@index, 0);;
    assert_eq(|_| "first link display text", links.@(0).@display_text, "A");;
    assert_eq(|_| "second link URL", links.@(1).@url, "http://b");;
    assert_eq(|_| "second link index", links.@(1).@index, 1);;
    assert_eq(|_| "second link display text", links.@(1).@display_text, "B")
);

run_link_in_nested_list : IO ();
run_link_in_nested_list = (
    let src = "- [X](http://x)\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    assert_eq(|_| "list item link enumerated", links.get_size, 1);;
    assert_eq(|_| "list item link URL", links.@(0).@url, "http://x");;
    assert_eq(|_| "list item link index", links.@(0).@index, 0)
);

run_link_in_table_cell : IO ();
run_link_in_table_cell = (
    let src = "| Site |\n| --- |\n| [T](http://t) |\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    assert_eq(|_| "table cell link enumerated", links.get_size, 1);;
    assert_eq(|_| "table cell link URL", links.@(0).@url, "http://t")
);

run_image_excluded : IO ();
run_image_excluded = (
    let src = "![alt](http://img.example/x.png) and [L](http://l)\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    assert_eq(|_| "image excluded; only the real link counts",
        links.get_size, 1);;
    assert_eq(|_| "non-image link URL", links.@(0).@url, "http://l")
);

run_index_matches_array_position : IO ();
run_index_matches_array_position = (
    let src = "[A](http://a) and [B](http://b) and [C](http://c)\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    let n = links.get_size;
    let ok = loop((true, 0), |(acc, i)| (
        if i >= n { break $ acc };
        let li = links.@(i);
        continue $ (acc && li.@index == i, i + 1)
    ));
    assert_eq(|_| "index matches array position for every entry",
        ok, true);;
    assert_eq(|_| "three links collected", n, 3)
);

run_display_text_discards_style : IO ();
run_display_text_discards_style = (
    let src = "[**bold** part](https://example.com)\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    assert_eq(|_| "display text discards inline markup",
        links.@(0).@display_text, "bold part")
);

run_link_inside_emph : IO ();
run_link_inside_emph = (
    let src = "*see [here](http://here)*\n";
    let doc = Parser::parse(src);
    let links = collect_links(doc);
    assert_eq(|_| "link nested inside emph enumerated", links.get_size, 1);;
    assert_eq(|_| "nested-in-emph URL", links.@(0).@url, "http://here")
);

run : IO ();
run = (
    run_empty_document;;
    run_multiple_links_across_paragraphs;;
    run_link_in_nested_list;;
    run_link_in_table_cell;;
    run_image_excluded;;
    run_index_matches_array_position;;
    run_display_text_discards_style;;
    run_link_inside_emph;;
    println("LinkEnumerationTest: link enumeration OK")
);
