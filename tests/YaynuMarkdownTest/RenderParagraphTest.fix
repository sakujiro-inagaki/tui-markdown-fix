// Paragraph + heading + blank-row + clipping tests.
// Covers the scenarios in specs/markdown-render/spec.md under
// "Paragraph rendering with word-aware wrapping", "Heading rendering",
// and "Clipping".
module RenderParagraphTest;

import Yaynu.Markdown.Ast;
import Yaynu.Markdown.Parser;
import Yaynu.Markdown.Render;
import Yaynu.Markdown.Render.Options;
import Yaynu.Markdown.Style;
import Yaynu.Markdown.Test;
import Yaynu.Tui.Buffer;
import Yaynu.Tui.Rect;
import Yaynu.Tui.Width;

// Strip trailing spaces from each line of a debug-string dump so
// assertions can ignore the rect's right-edge padding.
// Strip trailing spaces / NULs from each line, then drop trailing
// fully-blank lines. Keeps interior blank lines (e.g. between blocks).
_strip_trailing : String -> String;
_strip_trailing = |s| (
    let lines = s.split("\n").map(|line| (
        let bs = line.get_bytes;
        let raw = bs.@size;
        let nz = if raw > 0 && bs.@(raw - 1) == 0_U8 { raw - 1 } else { raw };
        let len = loop(nz, |i| (
            if i <= 0 { break $ 0 };
            if bs.@(i - 1) == ' ' { continue $ i - 1 };
            break $ i
        ));
        line.get_sub(0, len)
    )).to_array;
    let m = lines.@size;
    let last = loop(m, |i| (
        if i <= 0 { break $ 0 };
        if lines.@(i - 1) == "" { continue $ i - 1 };
        break $ i
    ));
    Array::from_map(last, |i| lines.@(i)).to_iter.join("\n")
);

_render : String -> I64 -> I64 -> String;
_render = |src, w, h| (
    let opts = RenderOptions::default;
    _strip_trailing(Test::render_to_string(src, opts, w, h))
);

run_word_wrap : IO ();
run_word_wrap = (
    let out = _render("alpha beta gamma", 9, 3);
    assert_eq(|_| "wrap at whitespace within 9 cols",
        out, "alpha\nbeta\ngamma")
);

run_over_wide_char_break : IO ();
run_over_wide_char_break = (
    let out = _render("aaaaabbbbbccccc", 5, 4);
    assert_eq(|_| "over-wide token character-wraps",
        out, "aaaaa\nbbbbb\nccccc")
);

run_hard_break : IO ();
run_hard_break = (
    // Two-space trailing → hard break in v0.1 markdown parser.
    let src = "alpha  \nbeta";
    let out = _render(src, 20, 3);
    assert_eq(|_| "hard break splits into two rows",
        out, "alpha\nbeta")
);

run_blank_row_between_blocks : IO ();
run_blank_row_between_blocks = (
    let src = "first\n\nsecond";
    let out = _render(src, 20, 4);
    assert_eq(|_| "blank row separates paragraphs",
        out, "first\n\nsecond")
);

run_heading_blank_separator : IO ();
run_heading_blank_separator = (
    let src = "# Title\n\nbody";
    let out = _render(src, 20, 4);
    assert_eq(|_| "heading followed by blank then body",
        out, "Title\n\nbody")
);

run_clipping : IO ();
run_clipping = (
    // Render a 4-line document into a 2-line rect: returns 2.
    let opts = RenderOptions::default;
    let doc = Parser::parse("one\n\ntwo\n\nthree\n\nfour");
    let buf = Buffer::empty(10, 2);
    let rect = Rect::make(0, 0, 10, 2);
    let (rows, _) = Render::render(doc, opts, rect, buf);
    assert_eq(|_| "render returns rect.height when clipped", rows, 2)
);

run_estimate_height_matches_render : IO ();
run_estimate_height_matches_render = (
    let opts = RenderOptions::default;
    let doc = Parser::parse("one\n\ntwo\n\nthree");
    let h = Render::estimate_height(doc, opts, 20);
    let buf = Buffer::empty(20, h + 5);
    let rect = Rect::make(0, 0, 20, h + 5);
    let (rows, _) = Render::render(doc, opts, rect, buf);
    assert_eq(|_| "estimate_height equals render row count when rect is tall enough",
        rows, h)
);

run : IO ();
run = (
    run_word_wrap;;
    run_over_wide_char_break;;
    run_hard_break;;
    run_blank_row_between_blocks;;
    run_heading_blank_separator;;
    run_clipping;;
    run_estimate_height_matches_render;;
    println("RenderParagraphTest: paragraph and heading rendering OK")
);
