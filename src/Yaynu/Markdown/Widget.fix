// MarkdownView widget: a `Document` + `RenderOptions` + scroll offset
// that plugs into a `tui-fix` `Frame`.
//
// `MarkdownView::render` is shaped like `tui-fix`'s `Paragraph::render`
// (registered into `namespace Frame` as `render_markdown_view`) so a
// caller can swap one widget for the other without touching the
// surrounding `Frame` / `Rect` plumbing.
//
// Key handling carries the most recent `(rect_width, rect_height)` on
// the view itself so `handle_key` can clamp `scroll` without forcing
// callers to thread layout dimensions through their key router. The
// dimensions are stamped on every `render` call; before the first
// render they default to `(0, 0)` which makes scrolling a no-op.
module Yaynu.Markdown.Widget;

import Yaynu.Markdown.Ast;
import Yaynu.Markdown.Parser;
import Yaynu.Markdown.Render;
import Yaynu.Markdown.Render.Options;
import Yaynu.Markdown.Render.Block;
import Yaynu.Markdown.Style;
import Yaynu.Tui.Buffer;
import Yaynu.Tui.Cell;
import Yaynu.Tui.Frame;
import Yaynu.Tui.Rect;
import Yaynu.Tui.Style;
import Yaynu.Tui.Width;
import Yaynu.Term.Key;

type MarkdownView = box struct {
    document   : Document,
    options    : RenderOptions,
    scroll     : I64,
    // Most recent rect dimensions stamped during `render`. Read by
    // `handle_key` so scroll arithmetic can clamp without the caller
    // having to pass them. `(0, 0)` before the first render — keys
    // are effectively inert.
    last_rect  : (I64, I64)
};

namespace MarkdownView {

    // Parse the source once and wrap it in a view with default
    // options and scroll = 0.
    new : String -> MarkdownView;
    new = |src| MarkdownView {
        document  : Parser::parse(src),
        options   : RenderOptions::default,
        scroll    : 0,
        last_rect : (0, 0)
    };

    // Replace the render options. Document and scroll are preserved.
    with_options : RenderOptions -> MarkdownView -> MarkdownView;
    with_options = |opts, v| v.set_options(opts);

    // Replace the scroll offset directly. No clamping here — that's
    // `handle_key`'s job and is also enforced visually inside `render`.
    with_scroll : I64 -> MarkdownView -> MarkdownView;
    with_scroll = |n, v| v.set_scroll(n);

    // The total number of rows the document would occupy at `width`
    // with the view's current options. Equivalent to
    // `Render::estimate_height(v.@document, v.@options, width)`.
    total_height : I64 -> MarkdownView -> I64;
    total_height = |width, v| (
        Render::estimate_height(v.@document, v.@options, width)
    );

    // Every link in the view's document in source-DFS order. Thin
    // wrapper over `Ast::collect_links(v.@document)` — same enumeration,
    // same indices, so callers can drive TAB navigation without
    // importing `Yaynu.Markdown.Ast` directly.
    links : MarkdownView -> Array LinkInfo;
    links = |v| Ast::collect_links(v.@document);
}

namespace Frame {

    // `Frame`-side render entry matching `Paragraph::render` /
    // `Frame::render_paragraph` conventions: takes `(MarkdownView,
    // Rect, Frame)` and returns the updated `Frame`.
    //
    // Behaviour:
    // 1. Build the full rendered-line sequence for the document at
    //    `rect.width`.
    // 2. Skip `scroll` rows (when `scroll` exceeds the total, the
    //    visible window is empty — the rect stays blank).
    // 3. Write the visible window into the rect via the same blitter
    //    used by `Render::render`.
    // 4. Stamp `(rect.width, rect.height)` onto the view so the
    //    next `handle_key` call can clamp correctly.
    render_markdown_view : MarkdownView -> Rect -> Frame -> Frame;
    render_markdown_view = |view, rect, frame| (
        if rect.is_empty { frame };
        let (lines, _next_idx) = render_blocks(view.@document.@blocks,
                                                view.@options, rect.@width, 0);
        let scroll = if view.@scroll < 0 { 0 } else { view.@scroll };
        let n = lines.@size;
        let skipped = if scroll >= n { [] } else {
            Array::from_map(n - scroll, |i| lines.@(scroll + i))
        };
        // Reuse `Render::render`'s line blitter by constructing a
        // pseudo-document — instead just re-create the loop here.
        let h = if skipped.@size > rect.@height { rect.@height }
                else { skipped.@size };
        let frame2 = loop((frame, 0), |(f, i)| (
            if i >= h { break $ f };
            let line = skipped.@(i);
            let f2 = f.mod_buffer(|b| _write_spans(line, rect, i, b));
            continue $ (f2, i + 1)
        ));
        frame2
    );
}

// Stamp the rect dimensions on the view (used to remember the most
// recent layout for `handle_key`). Defined outside `namespace
// MarkdownView` so callers can use it as `view.remember_rect(...)`.
remember_rect : Rect -> MarkdownView -> MarkdownView;
remember_rect = |rect, v| v.set_last_rect((rect.@width, rect.@height));

// Render entry that also stamps the rect onto the view. Returns the
// updated `(view, frame)` pair so callers can persist the view's
// updated `last_rect` for subsequent `handle_key` calls.
//
// Use this when you need accurate clamping; the plain
// `Frame::render_markdown_view` is the drop-in for `Paragraph::render`
// and intentionally drops the `last_rect` update on the floor.
render_view : MarkdownView -> Rect -> Frame -> (MarkdownView, Frame);
render_view = |view, rect, frame| (
    let view2 = view.remember_rect(rect);
    let frame2 = frame.render_markdown_view(view2, rect);
    (view2, frame2)
);

// Update `scroll` in response to a key. Recognised keys (each clamps
// to `[0, max(0, total_height(rect_w, view) - rect_h)]`):
//   - Arrow Down / `j`     : scroll += 1
//   - Arrow Up   / `k`     : scroll -= 1
//   - PageDown   / Space   : scroll += rect_h
//   - PageUp               : scroll -= rect_h
//   - Home       / `g`     : scroll = 0
//   - End        / `G`     : scroll = clamp upper bound
// Any other key returns the view unchanged.
handle_key : Key -> MarkdownView -> MarkdownView;
handle_key = |k, v| (
    let (rect_w, rect_h) = v.@last_rect;
    let upper = (
        let total = v.total_height(rect_w);
        let u = total - rect_h;
        if u < 0 { 0 } else { u }
    );
    let _clamp = |n| if n < 0 { 0 } else if n > upper { upper } else { n };
    let new_scroll = match k {
        arrow_down() => _clamp(v.@scroll + 1),
        arrow_up()   => _clamp(v.@scroll - 1),
        page_down()  => _clamp(v.@scroll + rect_h),
        page_up()    => _clamp(v.@scroll - rect_h),
        home()       => 0,
        end_key()    => upper,
        char(s) => (
            if      s == "j" { _clamp(v.@scroll + 1) }
            else if s == "k" { _clamp(v.@scroll - 1) }
            else if s == " " { _clamp(v.@scroll + rect_h) }
            else if s == "g" { 0 }
            else if s == "G" { upper }
            else { v.@scroll }
        ),
        _ => v.@scroll
    };
    v.set_scroll(new_scroll)
);

// ----------------------------------------------------------------------
// Internal: write a `RenderedLine` of styled spans at row `row` of
// `rect` in `buf`. Duplicates the (private) helper in `Render.fix` —
// kept local so this widget module doesn't depend on `Render`'s
// internals. If they diverge, the snapshot tests will catch it.
_write_spans : Array (String, Style) -> Rect -> I64 -> Buffer -> Buffer;
_write_spans = |spans, rect, row, buf| (
    let m = spans.@size;
    let (final_buf, _) = loop((buf, 0, 0), |(b, x_off, i)| (
        if i >= m { break $ (b, x_off) };
        let (text, style) = spans.@(i);
        let remaining = rect.@width - x_off;
        if remaining <= 0 { break $ (b, x_off) };
        let b2 = Buffer::set_string_clipped(rect, x_off, row, text, style, b);
        let w = Width::string_width(text);
        let written = if w <= remaining { w } else { remaining };
        continue $ (b2, x_off + written, i + 1)
    ));
    final_buf
);
